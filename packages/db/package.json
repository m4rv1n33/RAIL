    "db:migrate": "prisma migrate deploy",
    "seed": "node --import tsx seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2"
  },
  "devDependencies": {
    "prisma": "^5.10.2",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
